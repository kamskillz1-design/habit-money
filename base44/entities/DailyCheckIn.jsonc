{
  "name": "DailyCheckIn",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "spending_confidence": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "neutral",
        "high",
        "very_high"
      ]
    },
    "mood_optional": {
      "type": "string"
    },
    "spent_intentionally": {
      "type": "boolean"
    },
    "completed_challenge_action": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "string"
    },
    "selected_focus_for_tomorrow": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "check_in_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}