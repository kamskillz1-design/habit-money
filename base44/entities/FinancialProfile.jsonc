{
  "name": "FinancialProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "monthly_income_target": {
      "type": "integer"
    },
    "income_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "irregular",
        "prefer_not_to_say"
      ]
    },
    "essential_expense_target": {
      "type": "integer"
    },
    "current_cash_estimate": {
      "type": "integer"
    },
    "emergency_fund_target": {
      "type": "integer"
    },
    "primary_financial_priority": {
      "type": "string",
      "enum": [
        "reduce_spending",
        "build_emergency_fund",
        "save_for_goal",
        "manage_bills",
        "reduce_debt",
        "understand_habits",
        "other"
      ]
    },
    "primary_goal_id": {
      "type": "string"
    },
    "preferred_budget_method": {
      "type": "string",
      "enum": [
        "category_budget",
        "zero_based",
        "50_30_20",
        "flexible",
        "no_budget"
      ]
    },
    "debt_tracking_enabled": {
      "type": "boolean",
      "default": false
    },
    "bank_connection_enabled": {
      "type": "boolean",
      "default": false
    },
    "onboarding_step": {
      "type": "integer",
      "default": 0
    },
    "data_confidence_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "safe_to_spend_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}