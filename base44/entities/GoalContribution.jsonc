{
  "name": "GoalContribution",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "contribution_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "transaction_linked",
        "recurring",
        "challenge_reward",
        "imported",
        "adjustment"
      ],
      "default": "manual"
    },
    "note": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "goal_id",
    "amount",
    "contribution_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}