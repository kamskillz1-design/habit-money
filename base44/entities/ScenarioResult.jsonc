{
  "name": "ScenarioResult",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "month_number": {
      "type": "integer"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "contribution_amount": {
      "type": "integer"
    },
    "estimated_growth_amount": {
      "type": "integer"
    },
    "inflation_adjusted_value": {
      "type": "integer"
    },
    "remaining_debt_balance": {
      "type": "integer"
    },
    "cumulative_contributions": {
      "type": "integer"
    },
    "projected_balance": {
      "type": "integer"
    },
    "zero_return_balance": {
      "type": "integer"
    },
    "assumptions_version": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "scenario_id",
    "month_number"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}