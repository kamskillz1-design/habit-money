{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "transaction_date": {
      "type": "string",
      "format": "date"
    },
    "posted_date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "integer"
    },
    "direction": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "transfer_in",
        "transfer_out",
        "savings_contribution",
        "debt_payment",
        "refund"
      ]
    },
    "merchant_name": {
      "type": "string"
    },
    "merchant_normalized": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "CSV_import",
        "open_banking",
        "recurring_generated",
        "demo"
      ],
      "default": "manual"
    },
    "external_transaction_id": {
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "recurring_item_id": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "is_transfer": {
      "type": "boolean",
      "default": false
    },
    "is_refund": {
      "type": "boolean",
      "default": false
    },
    "is_excluded_from_budget": {
      "type": "boolean",
      "default": false
    },
    "is_excluded_from_insights": {
      "type": "boolean",
      "default": false
    },
    "is_shared": {
      "type": "boolean",
      "default": false
    },
    "attachment_reference": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number"
    },
    "reviewed_at": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "account_id",
    "direction",
    "amount",
    "transaction_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}