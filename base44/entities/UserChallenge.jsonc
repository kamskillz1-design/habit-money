{
  "name": "UserChallenge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "challenge_template_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "challenge_type": {
      "type": "string",
      "enum": [
        "no_spend_day",
        "no_spend_weekend",
        "save_amount",
        "expense_logging_streak",
        "home_cooking",
        "subscription_review",
        "wait_24_hours",
        "budget_check_in",
        "emergency_fund_starter",
        "custom"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "target_value": {
      "type": "integer"
    },
    "current_progress": {
      "type": "integer",
      "default": 0
    },
    "unit": {
      "type": "string",
      "default": "days"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "active",
        "completed",
        "skipped",
        "expired",
        "cancelled"
      ],
      "default": "active"
    },
    "completion_percentage": {
      "type": "integer",
      "default": 0
    },
    "reward_points": {
      "type": "integer"
    },
    "selected_category_id": {
      "type": "string"
    },
    "reflection_note": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "skipped_at": {
      "type": "string"
    },
    "skip_reason": {
      "type": "string"
    },
    "created_from_nudge_id": {
      "type": "string"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "title",
    "challenge_type",
    "start_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}