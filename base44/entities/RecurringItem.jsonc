{
  "name": "RecurringItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "amount": {
      "type": "integer"
    },
    "direction": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "savings_contribution",
        "debt_payment"
      ]
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "quarterly",
        "yearly",
        "custom"
      ]
    },
    "next_due_date": {
      "type": "string",
      "format": "date"
    },
    "last_processed_date": {
      "type": "string",
      "format": "date"
    },
    "billing_day": {
      "type": "integer"
    },
    "merchant_name": {
      "type": "string"
    },
    "is_subscription": {
      "type": "boolean",
      "default": false
    },
    "reminder_days_before": {
      "type": "integer",
      "default": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "ended"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "name",
    "amount",
    "direction",
    "frequency",
    "next_due_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}