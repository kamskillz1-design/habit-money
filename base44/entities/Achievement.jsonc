{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "achievement_type": {
      "type": "string",
      "enum": [
        "first_transaction",
        "first_budget",
        "first_goal",
        "first_contribution",
        "first_challenge",
        "challenge_streak",
        "savings_milestone",
        "weekly_review_streak",
        "no_spend_streak",
        "budget_check_in_streak",
        "data_cleanup",
        "custom"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "earned_at": {
      "type": "string"
    },
    "progress_value": {
      "type": "integer"
    },
    "target_value": {
      "type": "integer"
    },
    "badge_icon": {
      "type": "string"
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "is_visible": {
      "type": "boolean",
      "default": true
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "achievement_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}