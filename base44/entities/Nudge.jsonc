{
  "name": "Nudge",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "nudge_type": {
      "type": "string",
      "enum": [
        "transaction_logging",
        "budget_awareness",
        "spending_pattern",
        "goal_progress",
        "upcoming_bill",
        "challenge_progress",
        "weekly_review",
        "subscription_review",
        "positive_reinforcement",
        "data_quality",
        "custom"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "action_url": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "scheduled_at": {
      "type": "string"
    },
    "displayed_at": {
      "type": "string"
    },
    "acted_at": {
      "type": "string"
    },
    "dismissed_at": {
      "type": "string"
    },
    "dismissed_reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "displayed",
        "acted_on",
        "dismissed",
        "expired",
        "disabled"
      ],
      "default": "displayed"
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "unique_deduplication_key": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "nudge_type",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}