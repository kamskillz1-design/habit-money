{
  "name": "Scenario",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "scenario_type": {
      "type": "string",
      "enum": [
        "savings_growth",
        "weekly_saving",
        "spending_reduction",
        "subscription_cancellation",
        "emergency_fund",
        "debt_payoff",
        "custom"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "duration_months": {
      "type": "integer"
    },
    "current_balance": {
      "type": "integer"
    },
    "recurring_contribution_amount": {
      "type": "integer"
    },
    "contribution_frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "one_time_contribution_amount": {
      "type": "integer"
    },
    "assumed_annual_rate_percentage": {
      "type": "number",
      "default": 0
    },
    "annual_inflation_percentage": {
      "type": "number",
      "default": 0
    },
    "include_inflation": {
      "type": "boolean",
      "default": false
    },
    "use_zero_return_baseline": {
      "type": "boolean",
      "default": true
    },
    "debt_balance": {
      "type": "integer"
    },
    "debt_interest_rate_percentage": {
      "type": "number"
    },
    "extra_debt_payment_amount": {
      "type": "integer"
    },
    "baseline_result": {
      "type": "object"
    },
    "projected_result": {
      "type": "object"
    },
    "assumptions_text": {
      "type": "string"
    },
    "disclaimer_acknowledged_at": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "name",
    "scenario_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}