{
  "name": "BudgetAllocation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "household_id": {
      "type": "string"
    },
    "budget_period_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "planned_amount": {
      "type": "integer"
    },
    "actual_amount": {
      "type": "integer"
    },
    "variance_amount": {
      "type": "integer"
    },
    "alert_threshold_percentage": {
      "type": "integer",
      "default": 80
    },
    "alert_sent_80_at": {
      "type": "string"
    },
    "alert_sent_100_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "budget_period_id",
    "category_id",
    "planned_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}